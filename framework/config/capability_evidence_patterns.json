            "is_escalated",
            "escalation_reason"
        ],

        "negative_keywords": [
            "escalation_time",
            "escalated_by"
        ],

        "expected_categories": [
            "categorical",
            "identifier_like",
            "numeric"
        ]
    },


    "EVENT_TIMESTAMP": {

