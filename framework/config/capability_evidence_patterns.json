            "created_at",
            "created_date",
            "event_time",
            "event_timestamp",
            "detected_at",
            "detected_time",
            "detection_time",
            "observed_at",
            "collected_at",
            "occurred_at",
            "timestamp",
            "detected"
        ],

        "negative_keywords": [
            "closed",
            "resolved",
            "resolution",
            "escalated",
            "escalation",
            "elapsed",
            "duration",
            "timeout",
            "lifetime",
            "age",
            "acknowledged"
        ],

        "expected_categories": [
