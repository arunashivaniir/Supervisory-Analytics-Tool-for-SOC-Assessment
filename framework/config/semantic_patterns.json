{
    "SECURITY_SEVERITY": {
        "_comment": [
            "Alert/incident severity only. Asset criticality, importance and",
            "business impact are a different axis and are NOT severity evidence,",
            "so a column whose name says criticality must never reach this",
            "concept, even when its values look like LOW/MEDIUM/HIGH/CRITICAL.",
            "",
            "value_patterns is deliberately absent. SemanticInference adds",
            "+0.25 for EVERY value pattern that matches (the break only exits the",
            "sample loop), so a severity-shaped value list contributes up to",
            "+1.00 and a name-keyword-free column such as asset_criticality could",
            "reach the 0.45 threshold on values alone. Name evidence is the only",
            "sound discriminator here; category and value agreement confirm it."
        ],
        "keywords": [
            "severity",
            "priority",
            "risk",
            "rating",
            "level"
        ],
        "negative_keywords": [
            "time",
            "date",
            "duration",
            "user",
            "owner",
            "closed_by",
            "criticality",
            "asset_criticality",
            "asset_importance",
            "business_impact"
        ],
        "expected_categories": [
            "categorical"
        ]
    },
